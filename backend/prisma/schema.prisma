generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                String    @id @default(uuid())
  tableId           String
  status            String    @default("OPEN")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  paymentReminder   Boolean   @default(false)
  reviewRequested   Boolean   @default(false)
  sessionNumber     Int       @default(0)
  deviceFingerprint String?
  locationVerified  Boolean   @default(false)
  feedback          String?
  orders            Order[]
  payments          Payment[]

  @@index([tableId])
  @@index([createdAt])
  @@index([status])
  @@index([tableId, status])
  @@index([createdAt, status])
}

model Order {
  id                 String      @id @default(uuid())
  sessionId          String
  status             String      @default("UNCONFIRMED")
  instructions       String?
  customerPhone      String?
  createdAt          DateTime    @default(now())
  estimatedReadyTime DateTime?
  isTakeaway         Boolean     @default(false)
  packingCharges     Int         @default(0)
  statusTimeline     Json?       @default("[]")
  session            Session     @relation(fields: [sessionId], references: [id])
  items              OrderItem[]
  payments           Payment[]

  @@index([sessionId])
  @@index([createdAt])
  @@index([status])
  @@index([sessionId, status])
  @@index([createdAt, status])
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  name     String
  price    Int
  quantity Int     @default(1)
  type     String  @default("DINE_IN")
  isServed Boolean @default(false)
  order    Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Payment {
  id        String   @id @default(uuid())
  sessionId String
  method    String
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  orderId   String?
  updatedAt DateTime @default(now()) @updatedAt
  order     Order?   @relation(fields: [orderId], references: [id])
  session   Session  @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([sessionId, status])
  @@index([createdAt, status])
}

model QrToken {
  id        String   @id @default(uuid())
  tableId   String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([tableId])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id                 String    @id @default(uuid())
  name               String
  price              Int
  categoryId         String
  descriptionEn      String?
  descriptionHi      String?
  image              String?
  priceLabel         String?
  rating             Float?
  ratingCount        Int?
  variants           String[]
  variantPrices      Json?
  tags               String[]
  outOfStock         Boolean   @default(false)
  outOfStockUntil    DateTime?
  discountPct        Int?
  discountFlat       Int?
  sortOrder          Int       @default(0)
  volume             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  outOfStockVariants String[]  @default([])
  category           Category  @relation(fields: [categoryId], references: [id])
}

model MenuVersion {
  id        String   @id @default(uuid())
  snapshot  Json
  changedBy String   @default("admin")
  note      String?
  createdAt DateTime @default(now())
}

model RestaurantStatus {
  id        String    @id @default("CURRENT")
  isOpen    Boolean   @default(true)
  closingAt DateTime?
  updatedAt DateTime  @updatedAt
}

model AnalyticsLog {
  id               String   @id @default(uuid())
  timestamp        DateTime @default(now())
  date             String
  tableId          String
  sessionId        String
  orderId          String
  itemName         String
  quantity         Int
  basePrice        Int
  discountApplied  String?
  finalPrice       Int
  paymentMode      String?
  paymentStatus    String
  orderStatus      String
  orderType        String
  packingCharges   Int      @default(0)
  locationVerified Boolean  @default(false)
  sessionNumber    Int      @default(0)
  rating           Int?
  
  // New deep analytics fields
  deviceType       String?
  browserName      String?
  osName           String?
  preparationTime  Int?     // duration in seconds from confirm to serve
  confirmationTime Int?     // duration in seconds from place to confirm
  totalDuration    Int?     // duration in seconds from place to serve
  cancellationReason String?
  adminAction      Boolean  @default(false)
  adminId          String?
  
  createdAt        DateTime @default(now())

  @@index([date])
  @@index([orderId])
  @@index([sessionId])
  @@index([tableId])
  @@index([createdAt])
  @@index([timestamp])
  @@index([itemName])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([date, orderStatus])
  @@index([sessionId, paymentStatus])
}

model DailySummary {
  id        String   @id @default(uuid())
  date      String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model OrderHistoryRecord {
  id               String   @id @default(uuid())
  orderId          String   @unique
  sessionId        String
  customerDetails  Json?
  items            Json     // Array of items with details
  totalAmount      Int
  taxesAndFees     Int      @default(0)
  paymentMethod    String?
  paymentStatus    String
  orderStatus      String
  timeline         Json     // Status changes with timestamps
  staffInfo        Json?
  pickupDelivery   Json?
  notes            String?
  feedback         String?
  createdAt        DateTime @default(now())
}

model Report {
  id        String   @id @default(uuid())
  type      String
  date      String
  filename  String
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([type, date])
}

model AuditLog {
  id        String   @id @default(uuid())
  eventType String   // PAYMENT_CREATED, PAYMENT_CONFIRMED, FRAUD_ATTEMPT, etc.
  sessionId String?
  paymentId String?
  orderId   String?
  userId    String?  // Admin user ID
  ipAddress String?
  userAgent String?
  details   Json     // Event-specific details (amounts, reasons, etc.)
  severity  String   // INFO, WARNING, CRITICAL
  timestamp DateTime @default(now())

  @@index([eventType])
  @@index([sessionId])
  @@index([paymentId])
  @@index([severity])
  @@index([timestamp])
}

model SessionCounter {
  key   String @id
  count Int    @default(0)
}

model PendingOrder {
  id        String   @id
  data      Json
  sessionId String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

