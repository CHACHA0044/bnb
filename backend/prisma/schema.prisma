generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                String    @id @default(uuid())
  tableId           String
  status            String    @default("OPEN")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  paymentReminder   Boolean   @default(false)
  reviewRequested   Boolean   @default(false)
  sessionNumber     Int       @default(0)
  deviceFingerprint String?
  locationVerified  Boolean   @default(false)
  feedback          String?
  orders            Order[]
  payments          Payment[]
}

model Order {
  id                 String      @id @default(uuid())
  sessionId          String
  status             String      @default("UNCONFIRMED")
  instructions       String?
  customerPhone      String?
  createdAt          DateTime    @default(now())
  estimatedReadyTime DateTime?
  isTakeaway         Boolean     @default(false)
  packingCharges     Int         @default(0)
  statusTimeline     Json?       @default("[]")
  session            Session     @relation(fields: [sessionId], references: [id])
  items              OrderItem[]
  payments           Payment[]
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  name     String
  price    Int
  quantity Int     @default(1)
  type     String  @default("DINE_IN")
  isServed Boolean @default(false)
  order    Order   @relation(fields: [orderId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  sessionId String
  method    String
  amount    Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  orderId   String?
  updatedAt DateTime @default(now()) @updatedAt
  order     Order?   @relation(fields: [orderId], references: [id])
  session   Session  @relation(fields: [sessionId], references: [id])
}

model QrToken {
  id        String   @id @default(uuid())
  tableId   String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id                 String    @id @default(uuid())
  name               String
  price              Int
  categoryId         String
  descriptionEn      String?
  descriptionHi      String?
  image              String?
  priceLabel         String?
  rating             Float?
  ratingCount        Int?
  variants           String[]
  variantPrices      Json?
  tags               String[]
  outOfStock         Boolean   @default(false)
  outOfStockUntil    DateTime?
  discountPct        Int?
  discountFlat       Int?
  sortOrder          Int       @default(0)
  volume             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  outOfStockVariants String[]  @default([])
  category           Category  @relation(fields: [categoryId], references: [id])
}

model MenuVersion {
  id        String   @id @default(uuid())
  snapshot  Json
  changedBy String   @default("admin")
  note      String?
  createdAt DateTime @default(now())
}

model RestaurantStatus {
  id        String    @id @default("CURRENT")
  isOpen    Boolean   @default(true)
  closingAt DateTime?
  updatedAt DateTime  @updatedAt
}

model AnalyticsLog {
  id               String   @id @default(uuid())
  timestamp        DateTime @default(now())
  date             String
  tableId          String
  sessionId        String
  orderId          String
  itemName         String
  quantity         Int
  basePrice        Int
  discountApplied  String?
  finalPrice       Int
  paymentMode      String?
  paymentStatus    String
  orderStatus      String
  orderType        String
  packingCharges   Int      @default(0)
  locationVerified Boolean  @default(false)
  sessionNumber    Int      @default(0)
  rating           Int?

  @@index([date])
  @@index([orderId])
  @@index([sessionId])
}

model DailySummary {
  id        String   @id @default(uuid())
  date      String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model OrderHistoryRecord {
  id               String   @id @default(uuid())
  orderId          String   @unique
  sessionId        String
  customerDetails  Json?
  items            Json     // Array of items with details
  totalAmount      Int
  taxesAndFees     Int      @default(0)
  paymentMethod    String?
  paymentStatus    String
  orderStatus      String
  timeline         Json     // Status changes with timestamps
  staffInfo        Json?
  pickupDelivery   Json?
  notes            String?
  feedback         String?
  createdAt        DateTime @default(now())
}

model Report {
  id        String   @id @default(uuid())
  type      String
  date      String
  filename  String
  data      Bytes
  createdAt DateTime @default(now())

  @@unique([type, date])
}

